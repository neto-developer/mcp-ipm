# CPF/CNPJ do prestador (somente digitos)
NFSE_USER=00000000000000

# Senha do prestador no sistema IPM
NFSE_PASS=sua_senha_aqui

# Codigo de cadastro do prestador no sistema IPM (ex: 5389)
NFSE_CADASTRO=0000

# Codigo TOM da cidade do prestador (Ibirama/SC = 8135)
NFSE_CIDADE=8135

# URL do Web Service NFS-e (opcional - default Ibirama/SC)
# NFSE_BASE_URL=https://ws-ibirama.atende.net/?pg=rest&service=WNERestServiceNFSe

# URL do Web Service PDF (opcional - detectada automaticamente da BASE_URL)
# NFSE_PDF_URL=https://ws-ibirama.atende.net/?pg=rest&service=WNERestPDFNFSe

# Modo teste: nfse nao registrada oficialmente (opcional, default false)
# NFSE_TEST_MODE=true

# Desabilitar verificacao SSL (opcional, default true - apenas para dev)
# NFSE_SSL_VERIFY=false

# Diretorio para logs de comunicacao (opcional, default ./nfse-logs)
# NFSE_LOG_DIR=./nfse-logs

# Debug: loga XML e respostas HTTP no stderr (opcional, default false)
# NFSE_DEBUG=true

# Porta HTTP para modo remoto (opcional - sem isso roda em modo stdio local)
# MCP_HTTP_PORT=3000

# URL publica do servidor (ex: https://mcp.exemplo.com)
# Quando definida, ativa OAuth 2.1 (necessario para Claude.ai)
# MCP_EXTERNAL_URL=https://mcp.exemplo.com

# Token Bearer simples (alternativa ao OAuth, para clientes que nao suportam OAuth)
# MCP_HTTP_TOKEN=troque-por-token-secreto-forte
