{
  "name": "mcp-ipm",
  "version": "1.0.0",
  "description": "MCP server for IPM Atende.Net NFS-e operations",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-ipm": "bin/install.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx --env-file=.env --watch src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector tsx --env-file=.env src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "fast-xml-parser": "^5.7.0",
    "iconv-lite": "^0.6.3",
    "uuid": "^11.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.7"
  }
}
